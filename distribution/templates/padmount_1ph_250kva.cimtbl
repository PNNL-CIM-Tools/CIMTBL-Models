# Single-phase loop-feed padmount: 250 kVA, 12470GrdY/7200 - 120/240 V, center-tapped secondary
#
# TransformerTankConfiguration = reusable tank design, like an OpenDSS XfmrCode.
# Instances Import this file and point their TransformerTank at it with
# TankConfiguration=padmount_1ph_250kva (see ../padmount_example.cimtbl).

Profile = cim18v17

Object TransformerTankConfiguration: mRID=xc_padmount_1ph_250kva, name=padmount_1ph_250kva, percentImpedance=2.56, noLoadLoss (W)=310, loadLoss (W)=2050

# Bushing/lug designations per IEEE C57.12.70-2020 (H1A/H1B = loop feed).
# sequenceNumber = the conductor the lug lands on (an instance's TransformerPhaseEnds
# carry the same numbers and the real phases): H2 and X2 share 5, the common neutral.
# The lugs come before the windings: in cim18v17 the winding<->lug links are
# written from the winding side (TransformerLug.From/ToTransformerWinding are
# serialize=False).
Table TransformerLug: mRID, designation, sequenceNumber, TankConfiguration=xc_padmount_1ph_250kva
    lug_h1a, H1A, 1
    lug_h1b, H1B, 2
    lug_h2,  H2,  5
    lug_x1,  X1,  3
    lug_x2,  X2,  5
    lug_x3,  X3,  4

# ratedU: phase-to-phase nameplate designation (IEEE C57.12.00-2021 Table 7).
# ratedS: the winding's own normal rating (each half-winding carries 125 kVA).
# baseU:  voltage across the winding's own terminals (= OpenDSS kVs).
# baseS:  primary rating, the base for both secondary halves (= OpenDSS kVAs).
# Percent impedances convert on the From winding's baseU^2/baseS.
# Polarity matches OpenDSS: X1->X2 (s1->N), X2->X3 (N->s2).
Table TransformerWinding: mRID, ratedS (kVA), baseS (kVA), ratedU (V), baseU (V), FromTransformerLug, ToTransformerLug, TankConfiguration=xc_padmount_1ph_250kva
    pad_wdg1, 250, 250, 12470, 7200, lug_h1a, lug_h2
    pad_wdg2, 125, 250, 240,   120,  lug_x1,  lug_x2
    pad_wdg3, 125, 250, 240,   120,  lug_x2,  lug_x3

# quality = inferred (not an attribute in cim18v17): half-winding impedances
# are not on the nameplate, so they come from the Hopkinson (1976) interlaced
# secondary model (Kersting Fig. 4.8; the basis of OpenDSS's center-tap example).
# Full-winding impedance from the configuration's nameplate values:
#   R = loadLoss / ratedS = 2050 / 250000          = 0.82 %
#   X = sqrt(percentImpedance^2 - R^2) = sqrt(2.56^2 - 0.82^2) = 2.4251 %
#   H - X1X2 = H - X2X3 = 1.5R + j1.2X  (OpenDSS Xhl, Xht)
#   X1X2 - X2X3         = 2.0R + j0.8X  (OpenDSS Xlt)
Table TransformerMeshImpedance: mRID, FromWinding, ToWinding, r (percent), x (percent)
    pad_mesh_12, pad_wdg1, pad_wdg2, 1.23, 2.9101
    pad_mesh_13, pad_wdg1, pad_wdg3, 1.23, 2.9101
    pad_mesh_23, pad_wdg2, pad_wdg3, 1.64, 1.9401
