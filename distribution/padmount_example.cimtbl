# One padmount instance built from the padmount_1ph_250kva tank configuration.

Profile = cim18v17
Authority = https://github.com/PNNL-CIM-Tools/CIMTBL-Models
Model = padmount_example

Import templates/padmount_1ph_250kva.cimtbl

Object PowerTransformer: mRID=xf_padmount_2341, name=padmount_2341

Object TransformerTank: mRID=xf_padmount_2341_tank, PowerTransformer=xf_padmount_2341, TankConfiguration=xc_padmount_1ph_250kva

Table ConnectivityNode: mRID
    cn_2341_hv
    cn_2341_lv

Table Terminal: mRID, sequenceNumber, phases, ConnectivityNode, ConductingEquipment
    t_2341_1, 1, AB,   cn_2341_hv, xf_padmount_2341
    t_2341_2, 2, s12N, cn_2341_lv, xf_padmount_2341

Table PowerTransformerEnd: mRID, endNumber, connectionKind, Terminal, PowerTransformer
    pad_2341_1, 1, Y, t_2341_1, xf_padmount_2341
    pad_2341_2, 2, I, t_2341_2, xf_padmount_2341

# The conductors the template's lugs land on (lug sequenceNumber = phase end
# sequenceNumber), with the real phases. 5 is the common neutral: H2 and X2.
Table TransformerPhaseEnd: mRID, endNumber, sequenceNumber, phase, phaseNeutralU (V), Terminal
    pad_2341_seq1, 1, 1, A,  7200, t_2341_1
    pad_2341_seq2, 1, 2, B,  7200, t_2341_1
    pad_2341_seq3, 2, 3, s1, 120,  t_2341_2
    pad_2341_seq4, 2, 4, s2, 120,  t_2341_2
    pad_2341_seq5, 2, 5, N,  0,    t_2341_2
