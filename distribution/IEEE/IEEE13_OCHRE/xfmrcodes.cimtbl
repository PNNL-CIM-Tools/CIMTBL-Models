    xc_xfcode_object_151_lug_h2, H2, 2
    xc_xfcode_object_151_lug_h3, H3, 3
    xc_xfcode_object_151_lug_h0, H0, 4
    xc_xfcode_object_151_lug_x1, X1, 5
    xc_xfcode_object_151_lug_x2, X2, 6
    xc_xfcode_object_151_lug_x3, X3, 7
    xc_xfcode_object_151_lug_x0, X0, 8

