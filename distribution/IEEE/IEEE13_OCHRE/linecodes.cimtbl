# IEEE 13 OCHRE line codes (OpenDSS LineCode -> PerLengthPhaseImpedance + PhaseImpedanceData)
#
# Matrices are written as the deck gives them (no Kron reduction). kron=yes is
# not applied: the codes with a neutral keep it as their last conductor, so the
# lines on them carry N in `phases` (see lines.cimtbl, triplex_lines.cimtbl).
# Conductor order = the deck's matrix order; conductorCount = nphases as written.
#
# Units: the deck's linecodes are units=mi, so r/x are ohm/mile as written.
# No cmatrix in the deck, so no `b` column.
#
# identifier = <parent mRID>_<row><column>; row/column are conductor indices, and
# ACLineSegmentPhase.sequenceNumber (the order of a line's `phases` column) picks the row.

Profile = cim18v17

Table PerLengthPhaseImpedance: mRID, name, conductorCount, calculatedFrequency (Hz)
    lc_object_14, OBJECT_14, 4, 60
    lc_object_15, OBJECT_15, 4, 60
    lc_object_16, OBJECT_16, 3, 60
    lc_object_17, OBJECT_17, 3, 60
    lc_object_18, OBJECT_18, 2, 60
    lc_object_21, OBJECT_21, 3, 60
    lc_object_22, OBJECT_22, 2, 60
    lc_triplex_line_configuration_1, triplex_line_configuration_1, 3, 60

# calculatedFrequency: OpenDSS default basefreq (60 Hz); the deck does not set it.
