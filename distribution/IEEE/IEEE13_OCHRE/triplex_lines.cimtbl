# IEEE 13 OCHRE triplex lines (OpenDSS TriplexLines.dss, 40 lines -> ACLineSegment)
#
# Each line runs from a center-tap secondary (trip_nodeK) to one triplex load bus
# (tl_house_N). The deck's cable has 3 conductors (s1, s2, N) with neutral=3, and
# kron=yes is not applied (as written, linecodes.cimtbl), so the line carries all three:
# phases = s1s2N, with N in the matrix's third position (the neutral conductor).
#
# Connection pattern (from the deck): house N is fed from trip_node((N-1) mod 15) + 1,
# and line OBJECT_(109+N) joins it, e.g. OBJECT_125 -> tl_house_16 on trip_node1.
# length 1.0 ft as written.

Profile = cim18v17

Table ACLineSegment: mRID, name, node1, node2, phases, length (ft), PerLengthImpedance, BaseVoltage=bv_240v, EquipmentContainer=fdr_ieee13ochre
    ln_object_110, OBJECT_110, trip_node1,  tl_house_1,  s1s2N, 1.0, lc_triplex_line_configuration_1
    ln_object_111, OBJECT_111, trip_node2,  tl_house_2,  s1s2N, 1.0, lc_triplex_line_configuration_1
    ln_object_112, OBJECT_112, trip_node3,  tl_house_3,  s1s2N, 1.0, lc_triplex_line_configuration_1
