# IEEE 13 OCHRE power transformers (OpenDSS Transformer -> PowerTransformer)
#
# Two forms, as in the worked example:
#   - a direct PowerTransformer with explicit ends: source_650 (VSource.dss, the
#     115/4.16 kV substation unit, no xfmrcode);
#   - units built on an xfmrcode, each a PowerTransformer + TransformerTank
#     (TankConfiguration = the code's template in xfmrcodes.cimtbl) + its ends +
#     TransformerPhaseEnds: transformer_633-634 (xfcode_OBJECT_151) and 15 single-phase
#     center-tapped units, end 1 = the primary phase, end 2 = the s1 s2 N secondary.
#     The phase ends carry the template lugs' conductor numbers and the real phases.
#
# Two-winding units: the deck's %loadloss is split evenly over the two ends
# (r = %loadloss / 2 per end, the CDPSM xfm1 convention). xhl is the mesh x (percent),
# on the From end. Wye windings with no neutral node in the deck -> Yn, grounded
# (OpenDSS default conn=wye; the CDPSM xfm1 precedent).
# Node names are the OpenDSS bus names. The center-tap node of each secondary
# (`trip_nodeN.0`) is the N conductor of end 2, which the triplex lines carry (s1s2N).

Profile = cim18v17

# --- source_650 (VSource.dss): 115 kV - 4.16 kV, 100000 kVA per winding, OpenDSS default
# wye on both windings. %loadloss=0.0001 -> r 0.00005 per end; xhl=0.0001 -> mesh x 0.0001.
# %noloadloss and %imag have no direct-PowerTransformer field, so they are dropped.
Object PowerTransformer: mRID=xf_source_650, name=source_650, vectorGroup=YNyn0, EquipmentContainer=sub_ieee13ochre

Table PowerTransformerEnd: mRID, node, phases, endNumber, connectionKind, grounded, ratedU (kV), ratedS (kVA), r (percent), BaseVoltage, PowerTransformer
    xf_source_650_1, rootbus, ABC, 1, Yn, true, 115,   100000, 0.00005, bv_115kv,  xf_source_650
    xf_source_650_2, node_650, ABC, 2, Yn, true, 4.160, 100000, 0.00005, bv_4p16kv, xf_source_650

Table TransformerMeshImpedance: mRID, FromTransformerEnd, ToTransformerEnd, x (percent)
    xf_source_650_mesh_12, xf_source_650_1, xf_source_650_2, 0.0001

# --- transformer_633-634: one tank on xfcode_OBJECT_151 (xfmrcodes.cimtbl), 500 kVA
# 4.16 - 0.48 kV wye-wye. The deck's buses are node_633.1.2.3 / node_634.1.2.3 (neutral
# to ground, OpenDSS default); the terminals carry N for the grounded neutrals.
Object PowerTransformer: mRID=xf_transformer_633-634, name=transformer_633-634, vectorGroup=YNyn0, EquipmentContainer=fdr_ieee13ochre

Object TransformerTank: mRID=xf_transformer_633-634_tank, PowerTransformer=xf_transformer_633-634, TankConfiguration=xc_xfcode_object_151, EquipmentContainer=fdr_ieee13ochre

Table PowerTransformerEnd: mRID, node, phases, endNumber, connectionKind, grounded, BaseVoltage, PowerTransformer
    xf_transformer_633-634_1, node_633, ABCN, 1, Yn, true, bv_4p16kv, xf_transformer_633-634
    xf_transformer_633-634_2, node_634, ABCN, 2, Yn, true, bv_480v,   xf_transformer_633-634

# The conductors the xfcode_OBJECT_151 lugs land on (lug sequenceNumber).
Table TransformerPhaseEnd: mRID, endNumber, sequenceNumber, phase, phaseNeutralU (kV), grounded, Terminal
    xf_transformer_633-634_1_a, 1, 1, A, 2.40178, ,     xf_transformer_633-634_T1
    xf_transformer_633-634_1_b, 1, 2, B, 2.40178, ,     xf_transformer_633-634_T1
    xf_transformer_633-634_1_c, 1, 3, C, 2.40178, ,     xf_transformer_633-634_T1
    xf_transformer_633-634_1_n, 1, 4, N, 0,       true, xf_transformer_633-634_T1
    xf_transformer_633-634_2_a, 2, 5, A, 0.27713,  ,     xf_transformer_633-634_T2
    xf_transformer_633-634_2_b, 2, 6, B, 0.27713,  ,     xf_transformer_633-634_T2
    xf_transformer_633-634_2_c, 2, 7, C, 0.27713,  ,     xf_transformer_633-634_T2
    xf_transformer_633-634_2_n, 2, 8, N, 0,       true, xf_transformer_633-634_T2

