# CYME TransformerDB XFM1_XFO -> TransformerTankConfiguration (tank-only template: two
# TransformerTankEnds with no phases, one winding per end, one mesh between them; the phases
# are on the instance's TransformerPhaseEnds in transformers.cimtbl).
#
# XFM1_XFO: ThreePhase, ShellForm, Yg_Yg, PhaseShift 0deg (YNyn0), NominalRatingKVA
# 500.001020, 4.16 kV - 0.48 kV (KVLL), grounding 0 ohm both sides, NoLoadLossesKW 0,
# MagnetizingCurrent 0.
# Impedance: Z1 = Z0 = 2.2825 %, X/R = X0/R0 = 1.8181. CYME gives Z and X/R, not R and X:
#   R = Z / sqrt(1 + XR^2) = 1.10 %,  X = R x XR = 2.00 %  (derived; same in both sequences)
# CYME's impedance is the primary-secondary pair, so it goes whole on the mesh; the windings
# carry no r. The ZeroSequenceImpedancePrimSec/PrimMag/SecMag entries (8, 20, 30 %) describe
# a magnetizing branch CIM has no field for here, so they are not carried.

Profile = cim18v17

Object TransformerTankConfiguration: mRID=xc_xfm1_xfo, name=XFM1_XFO, percentImpedance=2.2825, percentMagnetizingCurrent=0, noLoadLoss (W)=0

Object TransformerCore: mRID=xc_xfm1_xfo_core, form=shellForm, TankConfiguration=xc_xfm1_xfo

Table TransformerTankEnd: mRID, rground (ohm), xground (ohm), connectionKind, TankConfiguration=xc_xfm1_xfo
    xc_xfm1_xfo_end_1, 0, 0, Yn
    xc_xfm1_xfo_end_2, 0, 0, Yn

Table TransformerWinding: mRID, baseU (kV), ratedU (kV), baseS (kVA), ratedS (kVA), FromTransformerEnd, TankConfiguration=xc_xfm1_xfo
    xc_xfm1_xfo_wdg_1, 4.16, 4.16, 500.00102, 500.00102, xc_xfm1_xfo_end_1
    xc_xfm1_xfo_wdg_2, 0.48, 0.48, 500.00102, 500.00102, xc_xfm1_xfo_end_2

Object TransformerMeshImpedance: mRID=xc_xfm1_xfo_mesh, r (percent)=1.10, x (percent)=2.00, r0 (percent)=1.10, x0 (percent)=2.00, FromTransformerEnd=xc_xfm1_xfo_end_1, ToTransformerEnd=xc_xfm1_xfo_end_2, FromWinding=xc_xfm1_xfo_wdg_1, ToWinding=xc_xfm1_xfo_wdg_2
