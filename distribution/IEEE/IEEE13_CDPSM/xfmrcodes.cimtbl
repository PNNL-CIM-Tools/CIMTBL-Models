# IEEE 13 transformer codes (OpenDSS XfmrCode -> TransformerTankConfiguration)
#
# ct5: 1-phase pole-top, 5 kVA, 4160GrdY/2400 - 120/240 V, center-tapped secondary
#   OpenDSS: kvs=[2.4 0.12 0.12] kVAs=[5 5 5] %Rs=[0.6 1.2 1.2]
#            Xhl=2.04 Xht=2.04 Xlt=1.36 %imag=0.5 %noloadloss=0.2
# The %Rs are already the Hopkinson half-winding split (full winding R = 1.2 %,
# X = 1.7 %: Xhl = 1.2X, Xlt = 0.8X), so they transcribe directly:
# %Rs -> TransformerWinding.r, X** -> TransformerMeshImpedance.x.
#
# The primary phase end is `X` (phase to be assigned by the instance): the code
# is phase-agnostic, like an OpenDSS XfmrCode. The instance's end-1 terminal
# says which phase (Tpoletop: B).

Profile = cim18v17

# percentImpedance = sqrt(1.2^2 + 1.7^2); losses = %noloadloss and %R x 5 kVA
# (percentImpedance is mistyped ActivePower in cim18v17; should be PerCent)
Object TransformerTankConfiguration: name=ct5, percentImpedance=2.08, percentMagnetizingCurrent=0.5, noLoadLoss (W)=10, loadLoss (W)=60

Table TransformerPhaseEnd: name, endNumber, sequenceNumber, phase, phaseNeutralU (V), TankConfiguration=ct5
    ct5_h1, 1, 1, X,  2400
    ct5_x1, 2, 2, s1, 120
    ct5_x3, 2, 3, s2, 120
    ct5_n,  2, 4, N,  0

# baseU = OpenDSS kVs, baseS = OpenDSS kVAs; ratedS halves carry 2.5 kVA each.
# Polarity matches OpenDSS buses=[670.2 House.1.0 House.0.2]: s1->N, N->s2.
Table TransformerWinding: name, ratedS (kVA), baseS (kVA), ratedU (V), baseU (V), r (percent), FromTransformerEnd, ToTransformerEnd, TankConfiguration=ct5
    ct5_wdg1, 5,   5, 4160, 2400, 0.6, ct5_h1, ct5_n
    ct5_wdg2, 2.5, 5, 240,  120,  1.2, ct5_x1, ct5_n
    ct5_wdg3, 2.5, 5, 240,  120,  1.2, ct5_n,  ct5_x3

Table TransformerMeshImpedance: name, FromWinding, ToWinding, x (percent)
    ct5_mesh_12, ct5_wdg1, ct5_wdg2, 2.04
    ct5_mesh_13, ct5_wdg1, ct5_wdg3, 2.04
    ct5_mesh_23, ct5_wdg2, ct5_wdg3, 1.36
