# IEEE 13 power transformers (OpenDSS Transformer -> PowerTransformer)
#
# Per-end model: OpenDSS %r -> PowerTransformerEnd.r (percent, on the end's own
# ratedU^2/ratedS); each OpenDSS X -> a TransformerMeshImpedance x (percent, on
# the From end's ratedU^2/ratedS).
# A TransformerEnd's `node` puts its Terminal on the PowerTransformer
# (sequenceNumber = endNumber, mRID <transformer mRID>_T<endNumber>).

Profile = cim18v17

# --- Sub: 5000 kVA 115 kV delta - 4.16 kV wye (2 windings)
# The deck's impedances are RPN expressions that evaluate to XHL = 8/1000 = 0.008 %
# and %r = 0.5/1000 = 0.0005 % per winding; transcribed as evaluated. The deck
# says this is so bus 650 sits at 1.0 pu. (Published nameplate, R 1 % / X 8 %,
# is not used here; see README.)
# The wye winding has no neutral node in the deck, so it is grounded with no
# Rneut/Xneut (see README).
Object PowerTransformer: mRID=xf_sub, name=sub, vectorGroup=Dyn1, EquipmentContainer=sub_ieee13

Table PowerTransformerEnd: mRID, node, phases, endNumber, connectionKind, grounded, ratedU (kV), ratedS (kVA), r (percent), BaseVoltage, PowerTransformer=xf_sub
    xf_sub_1, sourcebus, ABC, 1, D,  false, 115,  5000, 0.0005, bv_115kv
    xf_sub_2, 650,       ABC, 2, Yn, true,  4.16, 5000, 0.0005, bv_4p16kv

Table TransformerMeshImpedance: mRID, FromTransformerEnd, ToTransformerEnd, x (percent)
    xf_sub_mesh_12, xf_sub_1, xf_sub_2, 0.008

# --- xfm1: 500 kVA 4.16 - 0.48 kV grounded wye-wye
Object PowerTransformer: mRID=xf_xfm1, name=xfm1, vectorGroup=YNyn0, EquipmentContainer=fdr_ieee13nodeckt

Table PowerTransformerEnd: mRID, node, phases, endNumber, connectionKind, grounded, ratedU (kV), ratedS (kVA), r (percent), BaseVoltage, PowerTransformer=xf_xfm1
    xf_xfm1_1, 633, ABC, 1, Yn, true, 4.16, 500, 0.55, bv_4p16kv
    xf_xfm1_2, 634, ABC, 2, Yn, true, 0.48, 500, 0.55, bv_480v

Object TransformerMeshImpedance: mRID=xf_xfm1_mesh_12, FromTransformerEnd=xf_xfm1_1, ToTransformerEnd=xf_xfm1_2, x (percent)=2
