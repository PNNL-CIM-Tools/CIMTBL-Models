    xc_subxfmr_wdg_h1h3, 115, 115, 5000, 1666.6667, 0.0005, xc_subxfmr_lug_h1, xc_subxfmr_lug_h3
    xc_subxfmr_wdg_h2h1, 115, 115, 5000, 1666.6667, 0.0005, xc_subxfmr_lug_h2, xc_subxfmr_lug_h1
    xc_subxfmr_wdg_h3h2, 115, 115, 5000, 1666.6667, 0.0005, xc_subxfmr_lug_h3, xc_subxfmr_lug_h2
    xc_subxfmr_wdg_x1x0, 4.16, 2.40178, 5000, 1666.6667, 0.0005, xc_subxfmr_lug_x1, xc_subxfmr_lug_x0
    xc_subxfmr_wdg_x2x0, 4.16, 2.40178, 5000, 1666.6667, 0.0005, xc_subxfmr_lug_x2, xc_subxfmr_lug_x0
    xc_subxfmr_wdg_x3x0, 4.16, 2.40178, 5000, 1666.6667, 0.0005, xc_subxfmr_lug_x3, xc_subxfmr_lug_x0

Table TransformerMeshImpedance: mRID, FromWinding, ToWinding, x (percent)
    xc_subxfmr_mesh_a, xc_subxfmr_wdg_h1h3, xc_subxfmr_wdg_x1x0, 0.008
    xc_subxfmr_mesh_b, xc_subxfmr_wdg_h2h1, xc_subxfmr_wdg_x2x0, 0.008
    xc_subxfmr_mesh_c, xc_subxfmr_wdg_h3h2, xc_subxfmr_wdg_x3x0, 0.008

# --- FdrXfmr: 500 kVA, 4.16 kV - 0.48 kV wye-wye (YNyn0). Deck: XHL=2, %r=.55 per
# winding, %NoLoadLoss=0.6, %imag=1.1. noLoadLoss = 0.6 % x 500 kVA = 3000 W (derived:
# the CIM attribute is in W); %imag -> percentMagnetizingCurrent.
Object TransformerTankConfiguration: mRID=xc_fdrxfmr, name=FdrXfmr, noLoadLoss (W)=3000, percentMagnetizingCurrent=1.1

