# IEEE 13 asset-variant capacitors and cap controls
# (OpenDSS Capacitor -> LinearShuntCompensator; CapControl -> RegulatingControl)
#
# nomU = OpenDSS kV (line-to-line for 3-phase, across the unit for 1-phase).
# bPerSection = nomQ / nomU^2 (total for the bank).
#
# CapControl -> RegulatingControl, written as the capacitor's child (<cap>_ctrl) and linked
# from the capacitor (ShuntCompensator.RegulatingControl).
#   Cap1 (type=time, on=8 off=19): mode timeScheduled. The on/off hours have no
#     cim18v17 attribute and are not represented.
#   Cap2 (type=voltage, on=115 off=125, ptratio=20): on/off are volts on the 120 V
#     secondary base, so targetValue = (115 + 125) / 2 x 20 = 2400 V and
#     targetDeadband = (125 - 115) x 20 = 200 V (the full band, as the regulator convention).
#     It senses line 684611 terminal 2 (bus 611): Terminal ln_684611_T2. ptphase=1 is the
#     element's first conductor, node 611.3, so monitoredPhase = C.
# Set Controlmode=OFF disables every control in the deck: enabled=false / controlEnabled=false.

Profile = cim18v17

Table RegulatingControl: mRID, name, mode, discrete, enabled, monitoredPhase, targetValue, targetDeadband, ptRatio, Terminal
    cap_cap1_ctrl, cap1, timeScheduled, true, false, , , , ,
    cap_cap2_ctrl, cap2, voltage,       true, false, C, 2400, 200, 20, ln_684611_T2

Table LinearShuntCompensator: mRID, name, node, phases, phaseConnection, grounded, nomQ (kVAr), nomU (kV), bPerSection (S), sections, normalSections, maximumSections, controlEnabled, RegulatingControl, BaseVoltage=bv_4p16kv, EquipmentContainer=fdr_ieee13nodecktassets
    cap_cap1, cap1, 675, ABC, Y, true, 600, 4.16, 0.034671, 1, 1, 1, false, cap_cap1_ctrl
    cap_cap2, cap2, 611, C,   Y, true, 100, 2.4,  0.017361, 1, 1, 1, false, cap_cap2_ctrl
