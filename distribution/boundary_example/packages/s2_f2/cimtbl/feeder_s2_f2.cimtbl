# Frame s2-f2: the feeder's own equipment, head recloser to its far end.

Profile = cim18v17

Object Feeder: mRID=fdr_s2_f2, name=s2-f2, NormalEnergizingSubstation=sub_s2

# The head recloser is in this frame. Its bus side is the boundary node s2_bus, which this file names
# but does not declare. Its container is the Substation, which is reference data.
Object Recloser: mRID=sw_s2_f2, name=s2-f2 head, node1=s2_bus, node2=s2_f2_head, normalOpen=false, areaBoundary=true, BaseVoltage=bv_13p2kv, EquipmentContainer=sub_s2

# This feeder has no tie, so its only boundary node is the bus.
Table ACLineSegment: mRID, node1, node2, length (mile), PerLengthImpedance=lc_336_acsr, BaseVoltage=bv_13p2kv, EquipmentContainer=fdr_s2_f2
    ln_s2_f2_1, s2_f2_head, s2_f2_mid, 1.0
    ln_s2_f2_2, s2_f2_mid,  s2_f2_end, 1.5

Table EnergyConsumer: mRID, node, BaseVoltage=bv_13p2kv, EquipmentContainer=fdr_s2_f2
    ld_s2_f2_mid, s2_f2_mid
    ld_s2_f2_end, s2_f2_end
