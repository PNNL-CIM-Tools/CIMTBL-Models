# Frame s2-f2: the feeder's own equipment, from its head node to its far end.

Profile = cim18v17

Object Feeder: mRID=fdr_s2_f2, name=s2-f2, NormalEnergizingSubstation=sub_s2

# Its head node is a boundary node (boundary.cimtbl): named here, not declared. It has no tie.
Table ACLineSegment: mRID, node1, node2, length (mile), PerLengthImpedance=lc_336_acsr, BaseVoltage=bv_13p2kv, EquipmentContainer=fdr_s2_f2
    ln_s2_f2_1, s2_f2_head, s2_f2_mid, 1.0
    ln_s2_f2_2, s2_f2_mid,  s2_f2_end, 1.5

# Feeder.NormalHeadTerminal: the first span's terminal on the head node
Update Terminal: mRID=ln_s2_f2_1_T1, NormalHeadFeeder=fdr_s2_f2

Table EnergyConsumer: mRID, node, BaseVoltage=bv_13p2kv, EquipmentContainer=fdr_s2_f2
    ld_s2_f2_mid, s2_f2_mid
    ld_s2_f2_end, s2_f2_end
