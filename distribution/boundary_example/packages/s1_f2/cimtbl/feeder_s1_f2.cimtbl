# Frame s1-f2: the feeder's own equipment, head recloser to its far end.

Profile = cim18v17

Object Feeder: mRID=fdr_s1_f2, name=s1-f2, NormalEnergizingSubstation=sub_s1

# The head recloser is in this frame. Its bus side is the boundary node s1_bus, which this file names
# but does not declare. Its container is the Substation, which is reference data.
Object Recloser: mRID=sw_s1_f2, name=s1-f2 head, node1=s1_bus, node2=s1_f2_head, normalOpen=false, areaBoundary=true, BaseVoltage=bv_12p47kv, EquipmentContainer=sub_s1

# s1_f2_end is a boundary node (boundary_s1_f1-s1_f2.cimtbl): named here, not declared. It is the
# far side of tie 1, which is in frame s1-f1.
Table ACLineSegment: mRID, node1, node2, length (mile), PerLengthImpedance=lc_336_acsr, BaseVoltage=bv_12p47kv, EquipmentContainer=fdr_s1_f2
    ln_s1_f2_1, s1_f2_head, s1_f2_mid, 1.0
    ln_s1_f2_2, s1_f2_mid,  s1_f2_end, 1.5

Table EnergyConsumer: mRID, node, BaseVoltage=bv_12p47kv, EquipmentContainer=fdr_s1_f2
    ld_s1_f2_mid, s1_f2_mid
    ld_s1_f2_end, s1_f2_end
