# The boundary model: the nodes either side of each tie, and nothing else. Identical in every package.
#
# A boundary node is not an ownership or operating boundary. It is a node present in two feeders'
# packages so that they snap together when both are loaded.
#
# Each node names its container: the smallest area that contains both feeders. Import this file
# after areas.cimtbl and before any equipment, so that no feeder's equipment claims the node first.

Profile = cim18v17

# Tie between two feeders of substation 1
Table ConnectivityNode: mRID, ConnectivityNodeContainer=area_ss_s1
    s1_f1_end
    s1_f2_end

# Tie between a feeder of substation 1 and a feeder of substation 2
Table ConnectivityNode: mRID, ConnectivityNodeContainer=area_d_example
    s1_f3_end
    s2_f1_end
