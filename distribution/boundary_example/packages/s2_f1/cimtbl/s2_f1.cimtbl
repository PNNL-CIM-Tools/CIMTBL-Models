# Package s2-f1: the reference data, the boundary model, the frames of substation s2 and feeder s2-f1,
# then the steady state hypotheses of the boundary and of both frames.

Profile = cim18v17
Authority = https://github.com/PNNL-CIM-Tools/CIMTBL-Models
Model = boundary_example

Import catalog.cimtbl
Import containers.cimtbl
Import boundary.cimtbl
Import substation_s2.cimtbl
Import feeder_s2_f1.cimtbl
Import ssh_boundary.cimtbl
Import ssh_s2.cimtbl
Import ssh_s2_f1.cimtbl
