# Steady state hypothesis (SSH) of frame s2, normal operation: the source's set point and the
# breakers' positions, and nothing else. Load it after the frame's structural model.

Profile = cim18v17

Update EnergySource: mRID=src_s2, voltageMagnitude (kV)=13.2, voltageAngle (deg)=0

Update Table Breaker: mRID, open=false
    brk_s2_f1
    brk_s2_f2
