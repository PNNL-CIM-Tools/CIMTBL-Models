# Reference data: the containers that more than one frame names. Identical in every package.
#
# A frame model may reference only its own objects, the boundary models on its perimeter and the
# reference data. So a container that several frames name is reference data, not part of any frame:
# - the as-built ConnectedArea objects, which nest by ContainedWithin and change only with
#   construction, never with switching;
# - each Substation, which is the EquipmentContainer of the substation frame's source and of the
#   feeder-head reclosers in the feeder frames.

Profile = cim18v17

Object ConnectedArea: mRID=area_d_example, name=example, kind=distributionArea

Table ConnectedArea: mRID, name, kind=substationServiceArea, ContainedWithin=area_d_example
    area_ss_s1, s1
    area_ss_s2, s2

Table ConnectedArea: mRID, name, kind=feederArea, ContainedWithin
    area_f_s1_f1, s1-f1, area_ss_s1
    area_f_s1_f2, s1-f2, area_ss_s1
    area_f_s1_f3, s1-f3, area_ss_s1
    area_f_s2_f1, s2-f1, area_ss_s2
    area_f_s2_f2, s2-f2, area_ss_s2

Table Substation: mRID, name
    sub_s1, s1
    sub_s2, s2
