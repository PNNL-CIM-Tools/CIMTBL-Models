# Frame s1-s2 area: the distribution area itself. It holds what belongs to the area rather than to one
# substation or feeder: its service areas (as-built, nested by ContainedWithin), its Feeders, and the
# normally-open ties between them. Every feeder assembly carries it.
#
# A tie belongs to this frame, not to either of its feeders. Each feeder's last span ends on its own
# side of the tie, and both sides are boundary nodes (boundary.cimtbl), so each joint between this frame
# and a feeder is bilateral.

Profile = cim18v17

Object BaseVoltage: mRID=bv_12p47kv, nominalVoltage (kV)=12.47

Table ConnectedArea: mRID, kind, ContainedWithin
    s1_s2_dist_area, distributionArea,

    sub_s1_service_area, substationServiceArea, s1_s2_dist_area
    sub_s2_service_area, substationServiceArea, s1_s2_dist_area

    feed_area_s1_f1, feederArea, sub_s1_service_area
    feed_area_s1_f2, feederArea, sub_s1_service_area
    feed_area_s1_f3, feederArea, sub_s1_service_area

    feed_area_s2_f1, feederArea, sub_s2_service_area
    feed_area_s2_f2, feederArea, sub_s2_service_area

# The Substations are declared in their own frames, and restated here for the Feeders that name them
Table Substation: mRID
    sub_s1
    sub_s2

# Each feeder frame's equipment is contained by its Feeder, and its first span's head terminal names it
Table Feeder: mRID, name, NormalEnergizingSubstation
    fdr_s1_f1, s1-f1, sub_s1
    fdr_s1_f2, s1-f2, sub_s1
    fdr_s1_f3, s1-f3, sub_s1
    fdr_s2_f1, s2-f1, sub_s2
    fdr_s2_f2, s2-f2, sub_s2

# Tie 1 joins feeders s1-f1 and s1-f2 of substation s1; tie 2 joins feeder s1-f3 to feeder s2-f1 of
# substation s2. Both are 12.47 kV, because s2-f1 steps down from 13.2 kV before its side of tie 2.
# Each is contained by the smallest area that contains both of its feeders.
Table Disconnector: mRID, node1, node2, normalOpen, open, areaBoundary, BaseVoltage, EquipmentContainer
    sw_tie_s1_f1_s1_f2, s1_f1_bnd, s1_f2_bnd, true, true, true, bv_12p47kv, sub_s1_service_area
    sw_tie_s1_f3_s2_f1, s1_f3_bnd, s2_f1_bnd, true, true, true, bv_12p47kv, s1_s2_dist_area
