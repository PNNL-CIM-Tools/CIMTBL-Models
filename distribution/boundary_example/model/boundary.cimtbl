# The boundary model of the distribution area: every node where two of its frames meet, and nothing
# else. Each node joins exactly two frames. Identical in every feeder assembly.
#
# A node's container is the smallest area that contains both frames that meet there. Import this file
# after dso_area.cimtbl, whose areas it names, and before any other frame, because cimtables gives a
# node with no container the container of the first equipment that touches it.

Profile = cim18v17

Table ConnectivityNode: mRID, ConnectivityNodeContainer

    # Feeder head nodes: a substation breaker on one side, the feeder's first span on the other
    s1_f1_head, sub_s1_service_area
    s1_f2_head, sub_s1_service_area
    s1_f3_head, sub_s1_service_area
    s2_f1_head, sub_s2_service_area
    s2_f2_head, sub_s2_service_area

    # The two sides of tie 1, between feeders of the same substation: the tie on one side, a feeder's
    # last span on the other
    s1_f1_bnd, sub_s1_service_area
    s1_f2_bnd, sub_s1_service_area

    # The two sides of tie 2, between feeders of different substations
    s1_f3_bnd, s1_s2_dist_area
    s2_f1_bnd, s1_s2_dist_area
