# Feeder s2-f2: head recloser, two spans, two loads.

Profile = cim18v17

Object Feeder: mRID=fdr_s2_f2, name=s2-f2, NormalEnergizingSubstation=sub_s2

# The head recloser is between the feeder area and the rest of its substation service area, so it
# belongs to the substation and is flagged areaBoundary. It is written here, not in the substation
# file, so that a package does not carry its siblings' head devices.
Object Recloser: mRID=sw_s2_f2, name=s2-f2 head, node1=s2_bus, node2=s2_f2_head, normalOpen=false, areaBoundary=true, BaseVoltage=bv_13p2kv, EquipmentContainer=sub_s2

# Computed by a topology processor: the feeder side of the head recloser bounds the feeder area.
Update Terminal: mRID=sw_s2_f2_T2, BoundedConnectedArea=area_f_s2_f2

# This feeder has no tie, so it names no boundary node.
Table ACLineSegment: mRID, node1, node2, length (mile), PerLengthImpedance=lc_336_acsr, BaseVoltage=bv_13p2kv, EquipmentContainer=fdr_s2_f2
    ln_s2_f2_1, s2_f2_head, s2_f2_mid, 1.0
    ln_s2_f2_2, s2_f2_mid,  s2_f2_end, 1.5

Table EnergyConsumer: mRID, node, p (kW), q (kvar), BaseVoltage=bv_13p2kv, EquipmentContainer=fdr_s2_f2
    ld_s2_f2_mid, s2_f2_mid, 800, 200
    ld_s2_f2_end, s2_f2_end, 500, 120
