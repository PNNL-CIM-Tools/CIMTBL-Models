# Frame s1: substation s1 as CIM-Builder lays out a primitive single bus. The source stands for the
# grid behind the bus (10 % on 14 MVA at 12.47 kV, X/R = 10), and one breaker per feeder runs from
# the bus to that feeder's head node.
#
# The bus node is this frame's own. The head nodes are in the boundary model, so the joint with each
# feeder is bilateral. The frame declares its Substation, which its feeders name as their
# NormalEnergizingSubstation.

Profile = cim18v17

Object BaseVoltage: mRID=bv_12p47kv, nominalVoltage (kV)=12.47

Object Substation: mRID=sub_s1

Object ConnectivityNode: mRID=s1_bus, ConnectivityNodeContainer=sub_s1

Object BusbarSection: mRID=bus_s1, name=s1 bus, node=s1_bus, BaseVoltage=bv_12p47kv, EquipmentContainer=sub_s1

Object EnergySource: mRID=src_s1, name=s1, node=s1_bus, nominalVoltage (kV)=12.47, r (ohm)=0.11107, x (ohm)=1.1107, r0 (ohm)=0.11107, x0 (ohm)=1.1107, BaseVoltage=bv_12p47kv, EquipmentContainer=sub_s1

Table Breaker: mRID, name, node1=s1_bus, node2, normalOpen=false, open=false, areaBoundary=true, BaseVoltage=bv_12p47kv, EquipmentContainer=sub_s1
    brk_s1_f1, s1-f1 breaker, s1_f1_head
    brk_s1_f2, s1-f2 breaker, s1_f2_head
    brk_s1_f3, s1-f3 breaker, s1_f3_head
