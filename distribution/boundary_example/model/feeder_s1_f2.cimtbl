# Frame s1-f2: the feeder's own equipment, from its head node to its far end.

Profile = cim18v17

Object BaseVoltage: mRID=bv_12p47kv, nominalVoltage (kV)=12.47

Object Feeder: mRID=fdr_s1_f2, name=s1-f2, NormalEnergizingSubstation=sub_s1

Object MultiCircuitGroup: mRID=f2_f3_dbl_circuit

Object XYSpacing: mRID=rus_2_52_1, isTemplate=false, MultiCircuitGroup=f2_f3_dbl_circuit

Table WirePosition: identifier, xCoord (in), yCoord (in), sequenceNumber, circuitNumber, kind, XYSpacing=rus_2_52_1
    dbl_cct_pos_1, -56.0, -36.0, 1, 1, phase
    dbl_cct_pos_2, -19.0, -36.0, 2, 1, phase
    dbl_cct_pos_3, 56.0,  -36.0, 3, 1, phase
    dbl_cct_pos_7, 6.0,   -72.0, 7,  , neutral

Object PerLengthSequenceImpedance: mRID=lc_336_acsr, name=336 ACSR, r (ohm/mile)=0.306, x (ohm/mile)=0.627, r0 (ohm/mile)=0.592, x0 (ohm/mile)=1.89

Table ACLineSegment, mRID, node1, node2, length (mile), WireSpacing=rus_2_52_1, BaseVoltage=bv_12p47kv, EquipmentContainer=fdr_s1_f2, MultiCircuitGroup=f2_f3_dbl_circuit
    ln_s1_f2_1, s1_f2_head, s1_f2_mid, 1.0

Table ACLineSegment: mRID, node1, node2, length (mile), PerLengthImpedance=lc_336_acsr, BaseVoltage=bv_12p47kv, EquipmentContainer=fdr_s1_f2
    ln_s1_f2_2, s1_f2_mid,  s1_f2_end, 1.5
    ln_s1_f2_3, s1_f2_end,  s1_f2_bnd, 0.1

Update ACLineSegmentPhase: mRID, MultiCircuitGroup
    ln_s1_f1_1_A, f2_f3_dbl_circuit

Table EnergyConsumer: mRID, node, BaseVoltage=bv_12p47kv, EquipmentContainer=fdr_s1_f2
    ld_s1_f2_mid, s1_f2_mid
    ld_s1_f2_end, s1_f2_end

# Feeder.NormalHeadTerminal: the first span's terminal on the head node
Update Terminal: mRID=ln_s1_f2_1_T1, NormalHeadFeeder=fdr_s1_f2