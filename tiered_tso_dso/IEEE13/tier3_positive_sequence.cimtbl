# Tier 3 - Positive-Sequence Equivalent Model (initial feasibility studies)
#
# Kron-reduced, balanced: real lines, transformers and switches, but only
# three-phase ones and no per-phase objects (no *Phase children; a Terminal
# with no phases attribute is ABC by CIM default).
#   - Line impedances: positive/zero sequence from the 4-wire matrices,
#     Z1 = Zs - Zm, Z0 = Zs + 2 Zm (Zs/Zm = mean self/mutual), x length.
#   - 1- and 2-phase laterals are folded into their 3-phase tap bus:
#     645/646 -> 632, 684/611/652 -> 671, pole-top/house -> 670.
#   - The three single-phase regulators become one ganged equivalent
#     (step = mean of the 10/8/11 taps). The sectionaliser (1-phase) is dropped.
#   - No source impedance (tier 5) and no protection settings (tier 5).

Profile = cim18v17

Import common.cimtbl

Object EnergySource: name=source, node=sourcebus, nominalVoltage (kV)=115, voltageMagnitude (kV)=115, BaseVoltage=bv_115kv, EquipmentContainer=ieee13_sub

# Balanced (CGMES-style) transformer: series impedance on end 1, end 2 zero
Table PowerTransformer: name, vectorGroup, EquipmentContainer
    sub3, Dyn1,  ieee13_sub
    reg,  YNyn0, ieee13nodeckt
    xfm1, YNyn0, ieee13nodeckt

Table PowerTransformerEnd: name, node, endNumber, connectionKind, ratedU (kV), ratedS (kVA), r (percent), x (percent), BaseVoltage, PowerTransformer
    sub3_1, sourcebus, 1, D,  115,  5000, 1.0,  8.0,  bv_115kv,  sub3
    sub3_2, 650,       2, Yn, 4.16, 5000, 0,    0,    bv_4p16kv, sub3
    reg_1,  brkr,      1, Yn, 4.16, 5000, 0.01, 0.01, bv_4p16kv, reg
    reg_2,  rg60,      2, Yn, 4.16, 5000, 0,    0,    bv_4p16kv, reg
    xfm1_1, xf1,       1, Yn, 4.16, 500,  1.1,  2.0,  bv_4p16kv, xfm1
    xfm1_2, 634,       2, Yn, 0.48, 500,  0,    0,    bv_480v,   xfm1

Object RatioTapChanger: name=reg_taps, lowStep=-16, highStep=16, neutralStep=0, normalStep=0, step=9.667, stepVoltageIncrement=0.625, TransformerEnd=reg_2

# Feeder segments (positive/zero-sequence ohms for the segment)
Table ACLineSegment: name, node1, node2, length (ft), r (ohm), x (ohm), r0 (ohm), x0 (ohm), bch (uS), BaseVoltage=bv_4p16kv, EquipmentContainer=ieee13nodeckt
    650632, rg60, 632, 2000, 0.07044, 0.22605, 0.24753, 0.72234,
    632670, mid,  670, 667,  0.02349, 0.07539, 0.08255, 0.24090,
    670671, 670,  671, 1333, 0.04695, 0.15066, 0.16498, 0.48144,
    671680, 671,  680, 1000, 0.03522, 0.11302, 0.12376, 0.36117,
    632633, 632,  633, 500,  0.05607, 0.07199, 0.10034, 0.19606,
    692675, 692,  675, 500,  0.04560, 0.03903, 0.13276, 0.04253, 13.7069

# Protection device inventory + switching topology (no settings)
Table Breaker: name, node1, node2, normalOpen, BaseVoltage=bv_4p16kv, EquipmentContainer=ieee13nodeckt
    brkr1, 650, brkr, false
Table Recloser: name, node1, node2, normalOpen, BaseVoltage=bv_4p16kv, EquipmentContainer=ieee13nodeckt
    rec1, 632, mid, false
Table Fuse: name, node1, node2, ratedCurrent (A), normalOpen, BaseVoltage=bv_4p16kv, EquipmentContainer=ieee13nodeckt
    fuse1, 633, xf1, 100, false
Table LoadBreakSwitch: name, node1, node2, normalOpen, BaseVoltage=bv_4p16kv, EquipmentContainer=ieee13nodeckt
    671692, 671, 692, false

# Balanced bus loads (laterals folded in; total 3471 kW / 2105 kVAr)
Table EnergyConsumer: name, node, p (kW), q (kVAr), phaseConnection, BaseVoltage, EquipmentContainer=ieee13nodeckt
    load_632, 632, 400,  257, Y, bv_4p16kv
    load_670, 670, 205,  119, Y, bv_4p16kv
    load_671, 671, 1453, 826, Y, bv_4p16kv
    load_675, 675, 843,  462, Y, bv_4p16kv
    load_692, 692, 170,  151, D, bv_4p16kv
    load_634, 634, 400,  290, Y, bv_480v

Table LinearShuntCompensator: name, node, nomQ (kVAr), nomU (kV), bPerSection (S), sections, BaseVoltage=bv_4p16kv, EquipmentContainer=ieee13nodeckt
    cap_675, 675, 600, 4.16, 0.034671, 1
    cap_671, 671, 100, 4.16, 0.005779, 1

# Existing DER operating envelopes: P range on the unit, Q range on the
# inverter (+/-44 % of rating, IEEE 1547 Category B - illustrative)
Table PowerElectronicsConnection: name, node, ratedS (kVA), ratedU (kV), maxQ (kVAr), minQ (kVAr), BaseVoltage, EquipmentContainer=ieee13nodeckt
    pv_634,      634, 300, 0.48, 132, -132, bv_480v
    storage_634, 634, 200, 0.48, 88,  -88,  bv_480v
    pv_670,      670, 5,   4.16, 2.2, -2.2, bv_4p16kv
    storage_670, 670, 5,   4.16, 2.2, -2.2, bv_4p16kv

Table PhotoVoltaicUnit: name, minP (kW), maxP (kW), PowerElectronicsConnection, EquipmentContainer=ieee13nodeckt
    pv_634_unit, 0, 300, pv_634
    pv_670_unit, 0, 5,   pv_670

Table BatteryUnit: name, minP (kW), maxP (kW), ratedE (kWh), PowerElectronicsConnection, EquipmentContainer=ieee13nodeckt
    storage_634_unit, -200, 200, 400,  storage_634
    storage_670_unit, -5,   5,   13.5, storage_670
