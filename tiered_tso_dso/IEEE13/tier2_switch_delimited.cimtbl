# Tier 2 - Switch-Delimited Aggregate Data (self-screening)
#
# The feeder is cut at its switching devices into switch areas (ConnectedArea,
# kind=switchArea). Each zone is one bus (TopologicalNode) carrying that zone's aggregate load,
# generation and capacitance. Still no lines, no impedances, and no individual
# customers.
#
#   650 =brkr1=> zone_head  (regulators, 632, 633, 645, 646)
#     zone_head =rec1=>   zone_mid   (670, 671, 680, 684, 652, pole-top/house)
#     zone_head =fuse1=>  zone_xfm1  (xf1 / 634 at 480 V: school PV + storage)
#     zone_mid  =671692=> zone_675   (692, 675)
#     zone_mid  =sect1=>  zone_611   (tap, 611)
#
# Boundaries are explicit: each switch Terminal names the area it bounds.

Profile = cim18v17

Import common.cimtbl

Object ConnectedArea: mRID=area_ieee13_feeder_area, name=ieee13_feeder_area, kind=feederArea

Table ConnectedArea: mRID, name, kind, description, ContainedWithin=area_ieee13_feeder_area
    area_zone_head, zone_head, switchArea, breaker to recloser/fuse - 632 633 645 646
    area_zone_mid,  zone_mid,  switchArea, recloser downstream - 670 671 680 684 652
    area_zone_xfm1, zone_xfm1, switchArea, fuse downstream - 500 kVA to 480 V at 634
    area_zone_675,  zone_675,  switchArea, load-break switch downstream - 692 675
    area_zone_611,  zone_611,  switchArea, sectionaliser downstream - 611

Table TopologicalNode: mRID, BaseVoltage, ConnectivityNodeContainer
    sourcebus, bv_115kv,  sub_ieee13
    650,       bv_4p16kv, sub_ieee13
    zone_head, bv_4p16kv, area_zone_head
    zone_mid,  bv_4p16kv, area_zone_mid
    zone_xfm1, bv_4p16kv, area_zone_xfm1
    zone_675,  bv_4p16kv, area_zone_675
    zone_611,  bv_4p16kv, area_zone_611

Object EnergySource: mRID=src_source, name=source, bus=sourcebus, nominalVoltage (kV)=115, BaseVoltage=bv_115kv, EquipmentContainer=sub_ieee13

# Substation transformer summary: ratings and connection only, no impedance
Object PowerTransformer: mRID=xf_sub3, name=sub3, vectorGroup=Dyn1, EquipmentContainer=sub_ieee13

Table PowerTransformerEnd: mRID, bus, endNumber, connectionKind, ratedU (kV), ratedS (kVA), BaseVoltage, PowerTransformer=xf_sub3
    xf_sub3_1, sourcebus, 1, D,  115,  5000, bv_115kv
    xf_sub3_2, 650,       2, Yn, 4.16, 5000, bv_4p16kv

# Switching devices = zone boundaries (in the feeder area, per ConnectedAreaKind)
Table Breaker: mRID, name, normalOpen, EquipmentContainer=area_ieee13_feeder_area
    sw_brkr1, brkr1, false
Table Recloser: mRID, name, normalOpen, EquipmentContainer=area_ieee13_feeder_area
    sw_rec1, rec1, false
Table Fuse: mRID, name, normalOpen, EquipmentContainer=area_ieee13_feeder_area
    sw_fuse1, fuse1, false
Table LoadBreakSwitch: mRID, name, normalOpen, EquipmentContainer=area_ieee13_feeder_area
    sw_671692, 671692, false
Table Sectionaliser: mRID, name, normalOpen, EquipmentContainer=area_ieee13_feeder_area
    sw_sect1, sect1, false

Table Terminal: mRID, sequenceNumber, ConductingEquipment, TopologicalNode, BoundedConnectedArea
    sw_brkr1_T1,  1, sw_brkr1,  650,       area_ieee13_feeder_area
    sw_brkr1_T2,  2, sw_brkr1,  zone_head, area_zone_head
    sw_rec1_T1,   1, sw_rec1,   zone_head, area_zone_head
    sw_rec1_T2,   2, sw_rec1,   zone_mid,  area_zone_mid
    sw_fuse1_T1,  1, sw_fuse1,  zone_head, area_zone_head
    sw_fuse1_T2,  2, sw_fuse1,  zone_xfm1, area_zone_xfm1
    sw_671692_T1, 1, sw_671692, zone_mid,  area_zone_mid
    sw_671692_T2, 2, sw_671692, zone_675,  area_zone_675
    sw_sect1_T1,  1, sw_sect1,  zone_mid,  area_zone_mid
    sw_sect1_T2,  2, sw_sect1,  zone_611,  area_zone_611

# Zone aggregates (sum = tier 1 feeder total: 3471 kW / 2105 kVAr)
Table EnergyConsumer: mRID, name, bus, aggregate, p (kW), q (kVAr), BaseVoltage, EquipmentContainer
    ld_zone_head_load, zone_head_load, zone_head, true, 400,  257, bv_4p16kv, area_zone_head
    ld_zone_mid_load,  zone_mid_load,  zone_mid,  true, 1488, 865, bv_4p16kv, area_zone_mid
    ld_zone_xfm1_load, zone_xfm1_load, zone_xfm1, true, 400,  290, bv_4p16kv, area_zone_xfm1
    ld_zone_675_load,  zone_675_load,  zone_675,  true, 1013, 613, bv_4p16kv, area_zone_675
    ld_zone_611_load,  zone_611_load,  zone_611,  true, 170,  80,  bv_4p16kv, area_zone_611

Table PowerElectronicsConnection: mRID, bus, aggregate, ratedS (kVA), BaseVoltage, EquipmentContainer
    area_zone_mid_pv,       zone_mid,  true, 5,   bv_4p16kv, area_zone_mid
    area_zone_mid_storage,  zone_mid,  true, 5,   bv_4p16kv, area_zone_mid
    area_zone_xfm1_pv,      zone_xfm1, true, 300, bv_4p16kv, area_zone_xfm1
    area_zone_xfm1_storage, zone_xfm1, true, 200, bv_4p16kv, area_zone_xfm1

Table LinearShuntCompensator: mRID, name, bus, aggregate, nomQ (kVAr), nomU (kV), BaseVoltage, EquipmentContainer
    cap_zone_675_caps, zone_675_caps, zone_675, true, 600, 4.16, bv_4p16kv, area_zone_675
    cap_zone_611_caps, zone_611_caps, zone_611, true, 100, 4.16, bv_4p16kv, area_zone_611
