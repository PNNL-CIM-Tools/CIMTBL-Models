Profile = cim18v17
Authority = https://github.com/PNNL-CIM-Tools/CIMTBL-Models
Model = tier1sample

Object EnergySource: mRID=src_IEEE13nodeckt, name=IEEE13nodeckt

Object BaseFrequency: mRID=base_freq, frequency=60
Object BasePower: mRID=sbase, basePower (MVA)=100

Object Substation: mRID=sub_sub, name=sub
Object Feeder: mRID=fdr_tier1feeder, name=tier1feeder, NormalEnergizingSubstation=sub_sub

Object TopologicalNode: mRID=feeder_head_bus, ConnectivityNodeContainer=sub_sub

Table BaseVoltage: mRID, nominalVoltage (kV)
    base_115,  115
    base_4160, 4.16

Table EnergyConsumer: mRID, name, bus, p (kW), q (kVAr), BaseVoltage, EquipmentContainer=fdr_tier1feeder
    ld_aggregate_feeder_load, aggregate_feeder_load, feeder_head_bus, 3000, 1155, base_4160

Table PowerElectronicsConnection: mRID, bus, p (kW), q (kVAr), BaseVoltage, EquipmentContainer=fdr_tier1feeder
    aggregate_feeder_PV, feeder_head_bus, 400, 100, base_4160

